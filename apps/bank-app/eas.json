{
  "build": {
    "production": {
      "env": {
        "EXPO_PUBLIC_APP_VERSION": "242",
        "EXPO_PUBLIC_BASE_URL": "https://www.example.com",
        "EXPO_PUBLIC_BASE_URL_API": "https://dev-carte.example.com",
        "EXPO_PUBLIC_BUNDLE_IDENTIFIER": "com.example.bankapp",
        "EXPO_PUBLIC_NODE_ENV": "production",
        "EXPO_PUBLIC_SLUG_NAME_BANK_APP": "bank-app"
      },
      "ios": {
        "image": "macos-sequoia-15.3-xcode-16.2" // https://expo.dev/blog/apple-sdk-minimum-requirements
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_VERSION": "242",
        "EXPO_PUBLIC_BASE_URL": "https://www.example.com",
        "EXPO_PUBLIC_BASE_URL_API": "https://sandbox.example.com",
        "EXPO_PUBLIC_BUNDLE_IDENTIFIER": "com.example.bankapp",
        "EXPO_PUBLIC_NODE_ENV": "production",
        "EXPO_PUBLIC_SLUG_NAME_BANK_APP": "bank-app"
      }
    },
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_VERSION": "242",
        "EXPO_PUBLIC_BASE_URL": "https://www.example.com",
        "EXPO_PUBLIC_BASE_URL_API": "https://sandbox.example.com",
        "EXPO_PUBLIC_BUNDLE_IDENTIFIER": "com.example.bankapp",
        "EXPO_PUBLIC_NODE_ENV": "production",
        "EXPO_PUBLIC_SLUG_NAME_BANK_APP": "bank-app"
      },
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_VERSION": "242",
        "EXPO_PUBLIC_BASE_URL": "https://www.example.com",
        "EXPO_PUBLIC_BASE_URL_API": "https://dev-carte.example.com",
        "EXPO_PUBLIC_BUNDLE_IDENTIFIER": "com.example.bankapp",
        "EXPO_PUBLIC_NODE_ENV": "production",
        "EXPO_PUBLIC_SLUG_NAME_BANK_APP": "bank-app"
      },
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath":  "./service-account.json",
        "track": "production"
      },
      "ios": {
        "appleId": "dev1@example.com",
        "ascAppId": "6478209342",
        "appleTeamId": "UQH2YW6D6K"
      }
    }
  },
  "cli": {
    // "version": "~7.2.0",
    "promptToConfigurePushNotifications": false
  }
}