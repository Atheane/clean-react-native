{
  "name": "storybook-web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/storybook-web/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "@nx/webpack:webpack",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "compiler": "babel",
        "outputPath": "dist/apps/storybook-web",
        "index": "apps/storybook-web/src/index.html",
        "baseHref": "/",
        "main": "apps/storybook-web/src/main.tsx",
        "tsConfig": "apps/storybook-web/tsconfig.app.json",
        "assets": ["apps/storybook-web/src/favicon.ico", "apps/storybook-web/src/assets"],
        "styles": ["apps/storybook-web/src/styles.css"],
        "scripts": [],
        "isolatedConfig": true,
        "webpackConfig": "apps/storybook-web/webpack.config.js"
      },
      "configurations": {
        "development": {
          "extractLicenses": false,
          "optimization": false,
          "sourceMap": true,
          "vendorChunk": true
        },
        "production": {
          "fileReplacements": [
            {
              "replace": "apps/storybook-web/src/environments/environment.ts",
              "with": "apps/storybook-web/src/environments/environment.prod.ts"
            }
          ],
          "optimization": true,
          "outputHashing": "all",
          "sourceMap": false,
          "namedChunks": false,
          "extractLicenses": true,
          "vendorChunk": false
        }
      }
    },
    "serve": {
      "executor": "@nx/webpack:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "storybook-web:build",
        "hmr": true
      },
      "configurations": {
        "development": {
          "buildTarget": "storybook-web:build:development"
        },
        "production": {
          "buildTarget": "storybook-web:build:production",
          "hmr": false
        }
      }
    },
    "lint": {
      "executor": "@nx/linter:eslint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/storybook-web/**/*.{ts,tsx,js,jsx}"]
      }
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "storybook-web:build"
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/storybook-web/jest.config.ts",
        "passWithNoTests": true
      },
      "configurations": {
        "ci": {
          "ci": true,
          "codeCoverage": true
        }
      }
    },
    "storybook": {
      "executor": "@nx/storybook:storybook",
      "options": {
        "port": 4400,
        "configDir": "apps/storybook-web/.storybook"
      },
      "configurations": {
        "ci": {
          "quiet": true
        }
      }
    },
    "test-storybook": {
      "executor": "nx:run-commands",
      "options": {
        "command": "test-storybook -c apps/storybook-web/.storybook --url=http://localhost:4400"
      }
    },
    "chromatic": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "npx nx run storybook-web:build-storybook",
          "npx dotenv-cli -e .env -- npx chromatic --project-token=$CHROMATIC_PROJECT_TOKEN --storybook-build-dir=../../dist/storybook/storybook-web"
        ],
        "cwd": "apps/storybook-web"
      }
    },
    "build-storybook": {
      "executor": "@nx/storybook:build",
      "outputs": ["{options.outputDir}"],
      "options": {
        "outputDir": "dist/storybook/storybook-web",
        "configDir": "apps/storybook-web/.storybook"
      }
    }
  },
  "tags": []
}
